# PhishGuard Configuration

# Database
DATABASE_URL=sqlite:///./phishguard.db

# Redis
REDIS_URL=redis://localhost:6379/0

# ─── SMTP Relay ────────────────────────────────────────────
# For Gmail: use an App Password (Google Account → Security → App Passwords)
#   1. Go to https://myaccount.google.com/apppasswords
#   2. Generate a new app password for "Mail"
#   3. Paste it below (16 chars, no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=micu.georgealexandru@gmail.com
SMTP_PASS=iwazawwqutgudyfb 

# Sender identity (what the target sees)
FROM_EMAIL=Bank@ING.ro
FROM_NAME=SecureBank Security Team

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
BASE_URL=http://localhost:8000

# ─── AI Search (Gemini) ───────────────────────────────────────
# Used by the OSINT scraper to enrich scraped contacts with AI-powered analysis.
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model to use for AI enrichment (default: gemini-1.5-flash for cost efficiency)
GEMINI_MODEL=gemini-1.5-flash

# Anomaly Detection
ANOMALY_ENGINE=sklearn
# sklearn = MinCovDet Mahalanobis distance
# onnx = ONNX runtime model

# Rate Limiting / Fail2Ban
SOFT_BAN_THRESHOLD=5
HARD_BAN_THRESHOLD=10
BAN_WINDOW_SECONDS=60
SOFT_BAN_DURATION_SECONDS=300
HARD_BAN_DURATION_SECONDS=3600

# Victim Mini PCs (update with actual IPs)
VICTIM_PC1_IP=192.168.1.101
VICTIM_PC2_IP=192.168.1.102

# ─── Twilio (SMS + WhatsApp) ────────────────────────────────
# Sign up at https://www.twilio.com/try-twilio (free trial gives ~$15 credit)
# Get SID & Token from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# WhatsApp: enable sandbox at https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
# Targets must send "join <keyword>" to the sandbox number first
TWILIO_WHATSAPP_NUMBER=

# ─── Telegram Bot ────────────────────────────────────────────
# Create a bot via @BotFather in Telegram → get the token
# Targets must /start the bot first (bots can't initiate DMs)
TELEGRAM_BOT_TOKEN=

# ─── Lockdown Backend ─────────────────────────────────────────
# Which user database to lock down accounts in (set LOCKDOWN_BACKEND to one of the following):
LOCKDOWN_BACKEND=sqlite

# =========================================================
# 1. PostgreSQL Integration
# =========================================================
# Connect directly to an existing corporate PostgreSQL DB
# LOCKDOWN_BACKEND=postgresql
# LOCKDOWN_PG_DSN=postgresql://db_user:db_pass@10.0.0.50:5432/company_prod_db
# LOCKDOWN_PG_TABLE=employees
# LOCKDOWN_PG_ID_COLUMN=employee_id
# LOCKDOWN_PG_ACTIVE_COLUMN=is_active
# LOCKDOWN_PG_LOCKED_COLUMN=account_locked

# =========================================================
# 2. MySQL / MariaDB Integration
# =========================================================
# Connect directly to an existing MySQL DB
# LOCKDOWN_BACKEND=mysql
# LOCKDOWN_MYSQL_HOST=192.168.1.200
# LOCKDOWN_MYSQL_PORT=3306
# LOCKDOWN_MYSQL_USER=sec_admin
# LOCKDOWN_MYSQL_PASS=super_secure_password
# LOCKDOWN_MYSQL_DB=corporate_platform
# LOCKDOWN_MYSQL_TABLE=users

# =========================================================
# 3. Active Directory / OpenLDAP Integration
# =========================================================
# Disable network accounts directly in Windows AD
# LOCKDOWN_BACKEND=ldap
# LOCKDOWN_LDAP_URL=ldap://dc01.company.local:389
# LOCKDOWN_LDAP_BIND_DN=cn=phishguard_svc,ou=ServiceAccounts,dc=company,dc=local
# LOCKDOWN_LDAP_BIND_PW=svc_password_here
# LOCKDOWN_LDAP_BASE_DN=ou=Employees,dc=company,dc=local

# =========================================================
# 4. MongoDB Integration
# =========================================================
# Lock accounts in NoSQL collections
# LOCKDOWN_BACKEND=mongodb
# LOCKDOWN_MONGO_URI=mongodb://db_admin:secret@mongo.company.com:27017/
# LOCKDOWN_MONGO_DB=web_app_db
# LOCKDOWN_MONGO_COLLECTION=users
# LOCKDOWN_MONGO_ID_FIELD=_id

# =========================================================
# 5. Redis Integration
# =========================================================
# Set flags or wipe active sessions from Redis cache
# LOCKDOWN_BACKEND=redis
# LOCKDOWN_REDIS_URL=redis://redis.company.internal:6379/1
# LOCKDOWN_REDIS_USER_PREFIX=user:
# LOCKDOWN_REDIS_SESSION_PREFIX=session:

# =========================================================
# 6. REST API / Okta / Auth0 Integration
# =========================================================
# Trigger lockdowns via internal JSON HTTP API
# LOCKDOWN_BACKEND=api
# LOCKDOWN_API_BASE_URL=https://api.company.com/v1
# LOCKDOWN_API_TOKEN=Bearer xxxxxxx
# LOCKDOWN_API_DISABLE_ENDPOINT=/admin/users/{id}/disable
# LOCKDOWN_API_RESTORE_ENDPOINT=/admin/users/{id}/enable

# =========================================================
# Email Defense (IMAP Removal)
# =========================================================
# For Gmail: enable IMAP in settings, use App Password
# For demo: uses local file-based removal from captured_emails/
EMAIL_DEFENSE_MODE=local
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASS=
